# Postgres connection string
DATABASE_URL=postgres://localhost:5432/pact_dev
# HMAC key that signs mandates — any long random string, keep it secret
PACT_SIGNING_KEY=change-me-to-a-long-random-string
# This server's public URL (Railway: https://<service>.up.railway.app)
PACT_PUBLIC_URL=http://127.0.0.1:8787
# Your OAuth authorization server's issuer URL; leave empty for agent tokens only
PACT_AUTH_ISSUER=
PORT=8787
# Hand agents with a registered key a Tenuo credential on pact_claim (tenuo, or empty for none)
PACT_EXPORT_FORMAT=
