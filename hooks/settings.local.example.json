{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "/path/to/pact-board/hooks/pact-hook.sh code-web session-start", "timeout": 10 }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "/path/to/pact-board/hooks/pact-hook.sh code-web user-prompt-submit", "timeout": 10 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [{ "type": "command", "command": "/path/to/pact-board/hooks/pact-hook.sh code-web post-tool-use", "timeout": 10 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "/path/to/pact-board/hooks/pact-hook.sh code-web stop", "timeout": 10 }]
      }
    ]
  }
}
