# The OAuth/OIDC server people sign in with
PACT_AUTH_ISSUER=https://auth.example.com
# A confidential client registered there for this app, redirect URI <PACT_ADMIN_URL>/auth/callback
PACT_ADMIN_CLIENT_ID=
PACT_ADMIN_CLIENT_SECRET=
# The board's public URL (the Admin API is <board>/admin/api)
PACT_BOARD_URL=https://board.example.com
# This app's public URL. On Vercel it defaults to the production domain.
PACT_ADMIN_URL=http://localhost:3000
# Encrypts the session cookie (it holds tokens): 32+ random characters
PACT_ADMIN_SESSION_SECRET=
# Time zone for dates on screen
PACT_ADMIN_TIMEZONE=UTC
